PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/crickbuddy?schema=public

# Auth
JWT_SECRET=change_me_in_backend_env
JWT_REFRESH_SECRET=change_me_in_backend_env
JWT_EXPIRES_IN=30d

# CORS
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# Live cricket scoreboard provider (used by /api/matches)
CRIC_API_KEY=your_cricapi_key

# Where uploads are stored: "local" (./uploads, served at /uploads) or "cloudinary"
STORAGE_MODE=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Queue config for analysis jobs (without Redis, jobs run in-process one at a time)
ENABLE_ANALYSIS_QUEUE=false
# DIRECT_CONCURRENCY=1
# AI_REQUEST_TIMEOUT_MS=600000
# MAX_RECOVERY_ATTEMPTS=3
REDIS_URL=redis://localhost:6379

# AI microservice endpoint
AI_SERVICE_URL=http://localhost:8000
# Shared secret sent to the AI service; must equal AI_SERVICE_SECRET there
AI_SERVICE_SECRET=change_me_to_a_long_random_string

# Optional for ai-service only (not read by backend runtime)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
